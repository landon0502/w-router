/**
 * w-router — uni-app x（uvue）版入口。
 *
 * uni-app x 项目通过 `import { Router } from '@/uni_modules/w-router'` 解析到本文件
 * （utssdk/ 目录约定）。uni-app（vue/nvue）项目仍解析根目录 index.ts，互不干扰。
 */

// 核心类
export { Router } from './router.uts'
export { RouterIntercept } from './intercept.uts'
export { RouterEvents } from './events.uts'
export { RouteDataPipeline } from './pipeline.uts'

// 路由事件常量
export {
  onRouteParamsEventKey,
  onRouteDataEventKey,
  onRouteParamsOnBackEvtKey,
} from './router.uts'

// 枚举
export { NavigateType } from './interface.uts'

// 工具函数
export {
  getHistoryPage,
  pages,
  addRootPath,
  getNavigatorUrl,
  getPageKey,
  queryParams,
} from './utils.uts'

// 类型守卫与环境判断
export {
  isDevelopment,
  isProduction,
  isUndef,
  isTransparent,
  isPromise,
  isNvue,
  isNull,
  isUndefined,
  isFunction,
  isObject,
  isEmpty,
  findLastIndex,
} from './guards.uts'

// 类型导出
export {
  Middleware,
  AsyncMiddleware,
  RouteRecord,
  UniEventChannel,
  RouteEvents,
  RouteDataCacheContext,
  NavigationOptions,
  BackOptions,
  NavigationContext,
  PluginOptions,
  IRouter,
} from './interface.uts'
