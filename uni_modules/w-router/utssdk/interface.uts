/**
 * w-router — uni-app x（uvue）版公共类型定义。
 *
 * 与 vue 版（core/types.ts）公开 API 语义对齐，但适配 UTS 强类型约束：
 * - UTS 不支持对象索引签名 `[key: string]: ...`，事件集合用 Map<string, cb> 承载；
 * - 任意键值对象用 UTSJSONObject 承载；
 * - uvue 页面实例（UniPage）没有 `$:{uid}` 与 getOpenerEventChannel，
 *   页面唯一标识统一使用 route 字符串。
 */

// ============================================================================
// 枚举
// ============================================================================

/** 导航动作类型（与底层 uni.* API 的映射见 route-core.uts） */
export enum NavigateType {
  To = 'to',
  Redirect = 'redirect',
  Tab = 'tab',
  Launch = 'launch',
  Back = 'back',
}

// ============================================================================
// 页面记录 / 路由记录
// ============================================================================

/**
 * 事件通道。
 * uvue 下 uni-app x 未提供 page.getOpenerEventChannel，实际不依赖此通道，
 * 传参/数据统一走 uni.$emit / uni.$on + pipeline 缓存。此处保留以对齐 vue API 语义。
 */
export interface UniEventChannel {
  emit: (eventName: string, ...args: any[]) => void
  on?: (eventName: string, callback: (...args: any[]) => void) => void
  once?: (eventName: string, callback: (...args: any[]) => void) => void
  off?: (eventName: string, callback?: (...args: any[]) => void) => void
}

/** 页面记录（uvue 页面实例 UniPage 上可靠读取的字段为 route） */
export interface RouteRecord {
  route: string
}

// ============================================================================
// 页面级事件
// ============================================================================

/** 页面级事件回调 */
export type RouteEventCallback = (data: any) => void

/**
 * 页面级事件集合：事件名 → 回调。
 * 约定键：'onBack' 用于 back 回传参数（见 onRouteParamsOnBackEvtKey）。
 */
export type RouteEvents = Map<string, RouteEventCallback>

// ============================================================================
// 路由数据缓存
// ============================================================================

/** RouteDataPipeline 中存储的缓存条目 */
export interface RouteDataCacheContext {
  /** 来源页面 route（规范化，带前导 /） */
  from: string
  /** 目标页面 route（规范化，带前导 /） */
  to: string
  /** 正向传递的 params */
  params: any
  /** 正向传递的 data（不出现在 URL） */
  data: any
  /** back 回传回调 */
  onBack: RouteEventCallback | null
}

// ============================================================================
// 中间件
// ============================================================================

/** 同步中间件：不调用 next() 即阻止导航 */
export type Middleware = (context: NavigationContext, next: () => void) => void

/**
 * 异步中间件：next 返回 Promise，需要 `await next()`（或 `return next()`）以保持洋葱顺序。
 * UTS 不支持 `void | Promise<void>` 联合返回类型，故拆分同步/异步两个签名。
 */
export type AsyncMiddleware = (context: NavigationContext, next: () => Promise<void>) => Promise<void>

// ============================================================================
// 路由接口（避免类型循环引用）
// ============================================================================

/** Router 对外方法的最小接口（供 NavigationContext.router 使用） */
export interface IRouter {
  addRootPath(url: string | null): string
  getNavigatorUrl(fullUrl: string | null): string
  isTabBarPath(path: string): boolean
  getPrevRouterDataCache(): RouteDataCacheContext | null
  to(options: NavigationOptions): void
  redirect(options: NavigationOptions): void
  tab(options: NavigationOptions): void
  launch(options: NavigationOptions): void
  back(options: BackOptions | null): void
}

// ============================================================================
// 导航选项
// ============================================================================

/**
 * 导航选项。url 必填，其余字段可选（Router 内部归一化默认值）。
 * 自定义扩展字段放入 extra（UTSJSONObject），
 * openPage 时会显式构造转发给 uni.* 的对象，extra 不会被透传。
 */
export interface NavigationOptions {
  /** 目标页面路径（绝对路径如 '/pages/xxx/xxx'，可带 query） */
  url: string
  /** 路由参数——拼接到 URL query，并缓存到 pipeline */
  params?: any
  /** 隐式数据——不出现在 URL，仅通过 pipeline 缓存与 uni.$emit 传递 */
  data?: any
  /** 页面级事件集合（如 onBack 回传回调） */
  events?: RouteEvents | null
  /** 目标页已存在于页面栈时，后退而非新开 */
  backOpenedPage?: boolean
  /** 跳过全部拦截器 */
  notIntercept?: boolean
  /** 仅本次导航生效的自定义拦截器（在全局拦截器之前执行） */
  intercept?: Middleware | null
  /** navigateBack 的 delta（默认 1） */
  delta?: number
  /** 内部：导航类型 to/redirect/tab/launch/back（由 Router 方法设置） */
  type?: string | null
  /** 动画类型（App 生效） */
  animationType?: string | null
  /** 动画时长（毫秒，App 生效） */
  animationDuration?: number | null
  /** 导航成功回调 */
  success?: ((result: any) => void) | null
  /** 导航失败回调 */
  fail?: ((error: any) => void) | null
  /** 导航完成回调 */
  complete?: ((result: any) => void) | null
  /** 自定义扩展字段（不会被透传给 uni.*） */
  extra?: UTSJSONObject | null
}

/** back 选项（无 url） */
export interface BackOptions {
  delta?: number | null
  params?: any
  data?: any
  success?: ((result: any) => void) | null
  fail?: ((error: any) => void) | null
  complete?: ((result: any) => void) | null
}

/** 插件配置（new Router(options)） */
export interface PluginOptions {
  /** 预留：路由前缀 */
  basePath?: string | null
  /** 预留：自定义事件名格式化函数 */
  eventNameFormatter?: ((eventName: string, url: string) => string) | null
  /** TabBar 页面路径列表 */
  tabbarPaths?: Array<string> | null
}

// ============================================================================
// 中间件上下文
// ============================================================================

/** 传给中间件的导航上下文 */
export interface NavigationContext {
  /** 规范化 URL（带前导 /，query 保留） */
  url: string
  /** 路由实例 */
  router: IRouter
  /** 来源页面记录（尚无页面时为 null） */
  from: RouteRecord | null
  /** 路由参数（便捷访问，等同 options.params） */
  params: any
  /** 是否跳过拦截器（便捷访问，等同 options.notIntercept） */
  notIntercept: boolean
  /** 完整导航选项聚合 */
  options: NavigationOptions
}
