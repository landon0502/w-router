/**
 * w-router — 底层 uni.* 导航封装（uni-app x / uvue 版）。
 * 对应 vue 版 core/router.core.ts。
 *
 * UTS 差异：
 * - 无 Function.prototype.bind，不再做 this 绑定，改为显式传参的函数；
 * - 无 WeakMap/Object.getPrototypeOf 等，deepMerge 简化为显式字段归一化（toRouteConfig）；
 * - 不再透传 events/intercept/extra 给 uni.*（uvue 无 EventChannel，events 由 RouterEvents 自行管理）。
 */
import { addRootPath, queryParams } from './utils.uts'
import { RouteEvents, NavigationOptions } from './interface.uts'

/** 内部导航配置（归一化后的默认值 + 用户覆盖） */
export class RouteConfig {
  type: string = 'navigateTo'
  url: string = ''
  delta: number = 1
  params: any = null
  animationType: string = 'pop-in'
  animationDuration: number = 300
  events: RouteEvents | null = null
  success: ((result: any) => void) | null = null
  fail: ((error: any) => void) | null = null
  complete: ((result: any) => void) | null = null
}

/** 将 params 拼接到 url 上（已有 query 用 & 连接） */
function appendQuery(url: string, params: any): string {
  if (params == null) return url
  const base = addRootPath(url)
  const query = queryParams(params, false)
  if (query.length === 0) return base
  if (base.indexOf('?') === -1) {
    return base + '?' + query
  }
  return base + '&' + query
}

/** NavigationOptions → RouteConfig（替代 vue 版的 deepMerge + mixinParam） */
export function toRouteConfig(options: NavigationOptions): RouteConfig {
  const config = new RouteConfig()
  config.type = options.type != null ? options.type : 'navigateTo'
  config.url = appendQuery(options.url, options.params)
  config.delta = options.delta != null ? options.delta : 1
  config.params = options.params
  config.animationType = options.animationType != null ? options.animationType : 'pop-in'
  config.animationDuration = options.animationDuration != null ? options.animationDuration : 300
  config.events = options.events != null ? options.events : null
  config.success = options.success != null ? options.success : null
  config.fail = options.fail != null ? options.fail : null
  config.complete = options.complete != null ? options.complete : null
  return config
}

/** 执行路由跳转（type 兼容 'to'/'navigateTo' 两种写法） */
export function openPage(config: RouteConfig): void {
  const type = config.type

  if (type === 'navigateTo' || type === 'to') {
    uni.navigateTo({
      url: config.url,
      animationType: config.animationType,
      animationDuration: config.animationDuration,
      success: config.success,
      fail: config.fail,
      complete: config.complete,
    })
  } else if (type === 'redirectTo' || type === 'redirect') {
    uni.redirectTo({
      url: config.url,
      success: config.success,
      fail: config.fail,
      complete: config.complete,
    })
  } else if (type === 'switchTab' || type === 'tab') {
    uni.switchTab({
      url: config.url,
      success: config.success,
      fail: config.fail,
      complete: config.complete,
    })
  } else if (type === 'reLaunch' || type === 'launch') {
    uni.reLaunch({
      url: config.url,
      success: config.success,
      fail: config.fail,
      complete: config.complete,
    })
  } else if (type === 'navigateBack' || type === 'back') {
    uni.navigateBack({
      delta: config.delta,
      success: config.success,
      fail: config.fail,
      complete: config.complete,
    })
  }
}
