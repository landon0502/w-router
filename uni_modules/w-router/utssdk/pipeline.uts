/**
 * w-router — 路由数据管线（uni-app x / uvue 版）。
 * 对应 vue 版 core/RouteDataPipeline.ts，键从"页面 id"改为 route 字符串。
 */
import { RouteDataCacheContext } from './interface.uts'

export class RouteDataPipeline {
  private cache: Map<string, RouteDataCacheContext> = new Map()

  /** 为目标页面创建缓存条目 */
  create(ctx: RouteDataCacheContext): void {
    this.cache.set(ctx.to, {
      from: ctx.from,
      to: ctx.to,
      params: ctx.params,
      data: ctx.data,
      onBack: ctx.onBack,
    })
  }

  /** 按 route 获取缓存条目，无则返回 null */
  get(id: string): RouteDataCacheContext | null {
    const v = this.cache.get(id)
    return v != null ? v : null
  }

  /** 移除某 route 的缓存 */
  remove(id: string): void {
    this.cache.delete(id)
  }

  /** 是否存在某 route 的缓存 */
  has(id: string): boolean {
    return this.cache.has(id)
  }

  /** 清空全部缓存（tab/launch 导航时调用） */
  clear(): void {
    this.cache.clear()
  }
}
