/**
 * w-router UTS 主路由（uni-app x / uvue）
 *
 * 对应 core/Router.ts。UTS 适配点：
 * - 对象选项拷贝采用显式逐字段（UTS 无对象展开/rest 解构）
 * - uni.addInterceptor 不可用 → back 内显式清理 dataPipeline
 * - navigateBack 无 success 回调 → await 后同步触发 onBack
 * - override 方法不可带默认参数：back() 需显式传参（无参回退请传 null）
 */
import RouterIntercept from './Intercept'
import UvRouter from './router.core'
import { findLastIndex, isFunction } from './guards'
import { getHistoryPage, pages, getPageId } from './utils'
import RouteDataPipeline from './RouteDataPipeline'
import RouterEvents from './RouterEvents'
import type {
  NavigationOptions,
  NavigationContext,
  BackOptions,
  RouteRecord,
  RouteEvents,
  RouteDataCacheContext,
  PluginOptions,
  IRouter,
} from './types'

/** 路由参数事件 key（事件通道 / uni.$emit） */
export const onRouteParamsEventKey = 'onRouteParams'

/** 路由数据事件 key（与 params 分离，不进 URL） */
export const onRouteDataEventKey = 'onRouteData'

/** back 回传参数事件 key */
export const onRouteParamsOnBackEvtKey = 'onBack'

/** handleRouterDataCache 内部选项 */
type DataCacheOptions = {
  navUrl: string
  params?: any
  data?: any
  type?: string
  delta?: number
  backOpenedPage?: boolean
}

export default class Router implements IRouter {
  /** 中间件拦截引擎 */
  readonly interceptor = new RouterIntercept()

  /** 页面级事件总线 */
  readonly routerEvents = new RouterEvents()

  /** 路由数据管道 */
  readonly dataPipeline = new RouteDataPipeline()

  /** TabBar 页面路径清单 */
  tabbarPaths: string[]

  /** 底层导航实现（UvRouter 实例，代替模块级方法引用） */
  private uvRoute: UvRouter

  constructor(options?: PluginOptions) {
    this.tabbarPaths = options?.tabbarPaths ?? []
    this.uvRoute = new UvRouter()
    // 注：uvue 无 uni.addInterceptor，dataPipeline 的 back 清理改由 back() 显式触发
  }

  // ==========================================================================
  // URL Helpers
  // ==========================================================================

  /** 保证 url 带前导 "/" */
  addRootPath(url: string | null): string {
    if (url == null || url == '') return ''
    return url.startsWith('/') ? url : `/${url}`
  }

  /** 提取 URL 的路径部分，剥离 query */
  getNavigatorUrl(fullUrl: string | null): string {
    if (fullUrl == null || fullUrl == '') return ''
    return fullUrl.split('?')[0]
  }

  /** 判断页面路径是否为已配置的 TabBar 页面 */
  isTabBarPath(path: string): boolean {
    for (const item of this.tabbarPaths) {
      if (this.addRootPath(item) == this.addRootPath(path)) {
        return true
      }
    }
    return false
  }

  /** 链式设置 TabBar 路径 */
  setTabbarPaths(paths: string[]): Router {
    this.tabbarPaths = paths
    return this
  }

  /** 设置 type 后的导航选项副本（UTS 无对象展开，显式逐字段拷贝） */
  private withType(options: NavigationOptions, type: string): NavigationOptions {
    return {
      url: options.url,
      params: options.params,
      data: options.data,
      events: options.events,
      backOpenedPage: options.backOpenedPage,
      notIntercept: options.notIntercept,
      intercept: options.intercept,
      delta: options.delta,
      animationType: options.animationType,
      animationDuration: options.animationDuration,
      success: options.success,
      fail: options.fail,
      complete: options.complete,
      type,
    }
  }

  /** 去掉 intercept 的透传副本（intercept 只走拦截器链，不随底层导航执行） */
  private withoutIntercept(options: NavigationOptions): NavigationOptions {
    return {
      url: options.url,
      params: options.params,
      data: options.data,
      events: options.events,
      backOpenedPage: options.backOpenedPage,
      notIntercept: options.notIntercept,
      delta: options.delta,
      animationType: options.animationType,
      animationDuration: options.animationDuration,
      success: options.success,
      fail: options.fail,
      complete: options.complete,
      type: options.type,
    }
  }

  /** 构造 back 选项（NavigationOptions → BackOptions，覆盖 delta） */
  private buildBackOptions(options: NavigationOptions, delta: number): BackOptions {
    return {
      params: options.params,
      data: options.data,
      events: options.events,
      backOpenedPage: options.backOpenedPage,
      notIntercept: options.notIntercept,
      intercept: options.intercept,
      delta,
      type: options.type,
      success: options.success,
      fail: options.fail,
      complete: options.complete,
    }
  }

  /** 执行底层导航（uvue 下参数/数据经 RouteDataPipeline 缓存承载，无需事件通道发射） */
  routeHandler(options: NavigationOptions): void {
    this.uvRoute.doRoute(options)
  }

  // ==========================================================================
  // Event Registration
  // ==========================================================================

  /**
   * 注册页面级事件。events 保留在 options 中透传（uvue 的 navigateTo 原生支持 events）。
   */
  addRouterParamsEvent(options: NavigationOptions): void {
    const events: RouteEvents | null = options.events
    // RouteEvents 当前仅承载 onBack（UTS 无对象索引签名）
    if (events == null || events.onBack == null) {
      return
    }
    // 以当前页面 route 作为事件表 key（uvue 读不到稳定原生 id；同名 route 多开共用 key）
    const current: RouteRecord | null = getHistoryPage()
    if (current == null) return
    this.routerEvents.add(getPageId(current), events as RouteEvents)
  }

  // ==========================================================================
  // Data Pipeline Management
  // ==========================================================================

  /**
   * 管理路由数据缓存生命周期：
   * - tab/launch：清空全部（所有页面关闭）
   * - redirect：删除当前页缓存
   * - back：删除被 pop 页面缓存
   * - to：创建新缓存（backOpenedPage 且页已存在则跳过）
   */
  handleRouterDataCache(options: DataCacheOptions): void {
    const navUrl: string = options.navUrl
    const params: any | null = options.params
    const data: any | null = options.data
    const type: string | null = options.type
    const delta: number = options.delta ?? 0
    const backOpenedPage: boolean | null = options.backOpenedPage

    if (type == 'tab' || type == 'launch') {
      this.dataPipeline.clear()
    }

    const from: RouteRecord | null = getHistoryPage(0)

    if (type == 'redirect' && this.dataPipeline.has(this.addRootPath(from?.route))) {
      this.dataPipeline.remove(this.addRootPath(from?.route))
    }

    if (type == 'back') {
      const removeCacheIds: string[] = pages()
        .slice(-delta)
        .map((item: RouteRecord) => this.addRootPath(item.route))
      for (const id of removeCacheIds) {
        this.dataPipeline.remove(id)
      }
    }

    if (type != 'back') {
      const historyStack: RouteRecord[] = pages()
      const index: number = findLastIndex(
        historyStack,
        (item: RouteRecord) => this.addRootPath(item.route) == navUrl
      )

      if (backOpenedPage == true && index > -1) {
        return
      }

      this.dataPipeline.create({
        from: this.addRootPath(from?.route),
        to: navUrl,
        params,
        data,
      })
    }
  }

  // ==========================================================================
  // Main Route Method
  // ==========================================================================

  /**
   * 核心路由方法：规范化 URL → backOpenedPage 优化 → 中间件链 →
   * 全部放行后（finalHandler）提交数据缓存并真正导航。
   * 缓存写在放行点，守卫阻断时不会留下“未发生导航”的脏缓存。
   */
  route(options: NavigationOptions): Router {
    const url: string = this.addRootPath(this.getNavigatorUrl(options.url))

    // backOpenedPage：目标页已在栈中则回退到它（走 back() 自身清理，不写目标缓存）
    if (options.backOpenedPage == true) {
      const historyStack: RouteRecord[] = pages()
      const len = historyStack.length
      const index: number = findLastIndex(
        historyStack,
        (item: RouteRecord) => this.addRootPath(item.route) == url
      )
      if (index > -1 && len > 1) {
        const delta: number = len - index - 1
        if (delta > 0) {
          this.back(this.buildBackOptions(options, delta))
          return this
        }
      }
    }

    // 单次自定义拦截器不随 navOptions 透传：避免 doRoute 把 Middleware 当作旧式
    // intercept(config, resolve) 二次执行（Middleware 的 next() 无参会让 isNext 为 null，阻断导航）
    const navOptions: NavigationOptions = this.withoutIntercept(options)

    // notIntercept 解析（支持 boolean 与函数形式）
    let resolvedNotIntercept: boolean
    if (isFunction(options.notIntercept)) {
      const fn: () => boolean = options.notIntercept as () => boolean
      resolvedNotIntercept = fn()
    } else {
      resolvedNotIntercept = (options.notIntercept as boolean | null) == true
    }

    const context: NavigationContext = {
      router: this,
      url,
      options: navOptions,
      from: getHistoryPage(0),
    }

    this.interceptor.execute({
      context,
      notIntercept: resolvedNotIntercept,
      customIntercept: options.intercept,
      finalHandler: (_ctx: NavigationContext): void => {
        // 拦截全部放行后才提交数据缓存并真正导航——
        // 守卫阻断（如未登录跳登录页）时不留下“未发生导航”的脏缓存
        this.handleRouterDataCache({
          navUrl: url,
          params: navOptions.params,
          data: navOptions.data,
          type: navOptions.type,
          delta: navOptions.delta,
          backOpenedPage: navOptions.backOpenedPage,
        })
        this.routeHandler(navOptions)
      },
    })

    return this
  }

  // ==========================================================================
  // Cache Retrieval
  // ==========================================================================

  /** 获取当前页的缓存路由数据（无则 null） */
  getPrevRouterDataCache(): RouteDataCacheContext | null {
    const currentPage: RouteRecord | null = getHistoryPage()
    if (currentPage == null) return null
    return this.dataPipeline.get(this.addRootPath(currentPage.route)) ?? null
  }

  // ==========================================================================
  // Navigation Convenience Methods
  // ==========================================================================

  /** 跳转新页面（压栈） */
  to(options: NavigationOptions): void {
    this.addRouterParamsEvent(options)
    this.route(this.withType(options, 'to'))
  }

  /** 重定向（替换当前页） */
  redirect(options: NavigationOptions): void {
    this.addRouterParamsEvent(options)
    this.route(this.withType(options, 'redirect'))
  }

  /** 切换 TabBar 页面 */
  tab(options: NavigationOptions): void {
    this.route(this.withType(options, 'tab'))
  }

  /** 关闭全部页面并打开新页 */
  launch(options: NavigationOptions): void {
    this.route(this.withType(options, 'launch'))
  }

  /**
   * 回退 N 层。
   * uvue 下 navigateBack 无 success/fail/complete 回调：
   * await 返回后同步执行 success 回调与 onBack 回传；
   * 并显式清理被 pop 页面的数据缓存（替代 uni.addInterceptor）。
   */
  back(options: BackOptions | null): void {
    const delta: number =
      options != null && options.delta != null ? (options.delta as number) : 1
    const backPage: RouteRecord | null = getHistoryPage(-delta)
    // 导航前捕获源页 route key（页面 pop 后对象字段可能失效，route 不受影响）
    const backPageRouteId: string = getPageId(backPage) ?? ''

    // 显式清理被 pop 页面的缓存
    this.handleRouterDataCache({ navUrl: '', type: 'back', delta })

    const runBack = async (): Promise<void> => {
      try {
        await uni.navigateBack({ delta })
      } catch (e) {
        // 回退失败（如已在首页）——忽略
      }
      if (options != null && isFunction(options.success)) {
        const fn: (result: any) => void = options.success as (result: any) => void
        fn('')
      }
      if (options != null && options.params != null && backPageRouteId != '') {
        this.routerEvents.invoke(
          backPageRouteId,
          onRouteParamsOnBackEvtKey,
          options.params as any
        )
      }
    }

    runBack()
  }
}
