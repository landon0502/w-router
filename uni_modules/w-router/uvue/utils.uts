// @ts-nocheck
/**
 * w-router UTS 工具函数（uni-app x / uvue）
 *
 * 与 core/utils.ts 对齐；UTS 适配：
 * - getPageId/getPageKey 退化为页面 route（UniPage 读不到稳定原生 id）
 * - queryParams 基于 UTSJSONObject.toMap 遍历（UTS 无 Object.keys / 动态下标）
 * - Array 遍历用 for..of
 * - deepClone 以 JSON 序列化为主路径 + Map 缓存做循环检测
 */
import type { RouteRecord } from './types'

/**
 * 获取页面实例 key（页面 route 字符串）。
 *
 * uvue 的页面运行时对象（UniNormalPageImpl）无法 cast 到自定义接口，也读不到
 * 稳定的原生 id 字段；事件回传 key 退化为 route 路径（同一 route 多开时共用）。
 */
export function getPageKey(pageInstance?: RouteRecord): string {
  if (pageInstance == null) return ''
  return pageInstance.route
}

/**
 * 获取页面实例 id（公开 API，与 vue 版 getPageId 对齐）。
 * uvue 下等价于 getPageKey（即 route 字符串）。
 */
export function getPageId(pageInstance?: RouteRecord): string {
  return getPageKey(pageInstance)
}

/**
 * 深克隆（循环引用安全）。
 * 主路径 JSON 序列化；Date/RegExp/Map/Set/Array 显式分支。
 * 不可序列化字段（函数、循环引用下的 JSON 分支）放弃克隆，返回原引用。
 */
export function deepClone(obj: any, cache: Map<any, any> = new Map()): any {
  if (obj == null || typeof obj != 'object') return obj

  // Map.get 返回可空；命中缓存时（缓存值必非 null）断言后返回
  if (cache.has(obj)) {
    const cached: any | null = cache.get(obj)
    if (cached != null) {
      return cached as any
    }
  }

  if (obj instanceof Date) {
    const clone: Date = new Date(obj.getTime())
    cache.set(obj, clone)
    return clone
  }

  if (obj instanceof RegExp) {
    // UTS RegExp 无 flags，仅克隆 source
    const clone: RegExp = new RegExp(obj.source)
    cache.set(obj, clone)
    return clone
  }

  if (obj instanceof Map) {
    const clone: Map<any, any> = new Map()
    cache.set(obj, clone)
    obj.forEach((value: any, key: any) => {
      clone.set(key, deepClone(value, cache))
    })
    return clone
  }

  if (obj instanceof Set) {
    const clone: Set<any> = new Set()
    cache.set(obj, clone)
    obj.forEach((value: any) => {
      clone.add(deepClone(value, cache))
    })
    return clone
  }

  if (Array.isArray(obj)) {
    const clone: any[] = []
    cache.set(obj, clone)
    for (const item of obj) {
      clone.push(deepClone(item, cache))
    }
    return clone
  }

  // 普通对象：JSON 序列化主路径
  try {
    const parsed: any | null = JSON.parse(JSON.stringify(obj))
    if (parsed != null) {
      const jsonClone: any = parsed as any
      cache.set(obj, jsonClone)
      return jsonClone
    }
    return obj
  } catch (e) {
    // 不可序列化（循环引用等）——返回原引用
    return obj
  }
}

/**
 * 从导航历史栈中取页面实例。
 * back 为 0 或负数：0=当前页，-1=上一页，依此类推。默认 0。
 * 越界时返回 null（不再抛 IndexOutOfBounds）。
 */
export function getHistoryPage(back: number = 0): RouteRecord | null {
  const pageStack: RouteRecord[] = getCurrentPages() as RouteRecord[]
  const len = pageStack.length
  const index: number = len - 1 + back
  if (index < 0 || index >= len) return null
  return pageStack[index]
}

/**
 * 获取完整页面栈。
 */
export function pages(): RouteRecord[] {
  return getCurrentPages() as RouteRecord[]
}

/**
 * 获取当前页面路径（带前导斜杠；页面栈为空时返回 "/"）。
 */
export function page(): string {
  const pageStack: RouteRecord[] = getCurrentPages() as RouteRecord[]
  if (pageStack.length == 0) return '/'
  const route: string = pageStack[pageStack.length - 1].route
  return route == '' ? '/' : `/${route}`
}

/** 将任意值转字符串用于 URL 拼接（UTS 的 String() 只接受特定入参） */
function toQueryValue(value: any): string {
  if (typeof value == 'string') {
    return value as string
  }
  if (typeof value == 'number') {
    const num: number = value as number
    return `${num}`
  }
  if (typeof value == 'boolean') {
    const bool: boolean = value as boolean
    return `${bool}`
  }
  return JSON.stringify(value)
}

/**
 * 对象转 URL query 参数。
 *
 * UTS 原生端无 Object.keys、不支持对象动态下标遍历；
 * 未标注类型的对象字面量即 UTSJSONObject，转 Map<string,any> 后遍历。
 * @param data 对象（UTSJSONObject / 对象字面量）
 * @param isPrefix 是否自动加 "?"
 * @param arrayFormat 数组规则 indices|brackets|repeat|comma
 */
export function queryParams(
  data: any = {},
  isPrefix: boolean = true,
  arrayFormat: string = 'brackets'
): string {
  const prefix = isPrefix ? '?' : ''
  const _result: string[] = []
  let format = arrayFormat
  if (['indices', 'brackets', 'repeat', 'comma'].indexOf(format) == -1) {
    format = 'brackets'
  }

  const jsonObj: UTSJSONObject = data as UTSJSONObject

  // toMap 的值实际为可空 Any?（UTSJSONObject.toMap 官方示例即 (value: any | null, key)），
  // 直链 forEach 避免局部 Map 泛型（Any vs Any?）不一致
  jsonObj.toMap().forEach((value: any | null, key: string) => {
    // 跳过空值
    if (value == null || value == '') {
      return
    }
    // 数组另行处理
    if (Array.isArray(value)) {
      const arr: any[] = value as any[]
      switch (format) {
        case 'indices':
          // ids[0]=1&ids[1]=2
          for (let i = 0; i < arr.length; i++) {
            _result.push(`${key}[${i}]=${toQueryValue(arr[i])}`)
          }
          break
        case 'brackets':
          // ids[]=1&ids[]=2
          for (const item of arr) {
            _result.push(`${key}[]=${toQueryValue(item)}`)
          }
          break
        case 'repeat':
          // ids=1&ids=2
          for (const item of arr) {
            _result.push(`${key}=${toQueryValue(item)}`)
          }
          break
        case 'comma':
          // ids=1,2,3
          {
            let commaStr = ''
            for (const item of arr) {
              commaStr += (commaStr != '' ? ',' : '') + toQueryValue(item)
            }
            _result.push(`${key}=${commaStr}`)
          }
          break
        default:
          for (const item of arr) {
            _result.push(`${key}[]=${toQueryValue(item)}`)
          }
      }
    } else {
      _result.push(`${key}=${toQueryValue(value as any)}`)
    }
  })

  return _result.length > 0 ? prefix + _result.join('&') : ''
}
