<template>
	<scroll-view class="page" scroll-y="true">
		<view class="container">
			<view class="header">
				<text class="title">营销页 (Marketing)</text>
				<text class="subtitle">单次导航拦截器 (Per-Navigation Intercept) 示例</text>
			</view>

			<!-- ============================================================ -->
			<!-- Page Info -->
			<!-- ============================================================ -->
			<view class="section">
				<text class="section-title">页面信息</text>
				<view class="card">
					<text class="info-text">此页面需要经过自定义 intercept 校验才能访问。</text>
					<text class="info-text">从首页点击"自定义 intercept"按钮跳转时：</text>
					<view class="flow">
						<text class="flow-item">1. 显示 loading "校验中..."</text>
						<text class="flow-item">2. 模拟 1 秒异步校验</text>
						<text class="flow-item">3. 校验通过 → 执行导航，到达本页</text>
						<text class="flow-item">4. 校验不通过 → 显示错误提示，阻止导航</text>
					</view>
				</view>
			</view>

			<!-- ============================================================ -->
			<!-- Received Config -->
			<!-- ============================================================ -->
			<view class="section">
				<text class="section-title">接收的配置参数</text>
				<view class="card" v-if="layoutConfigId != ''">
					<text class="code">layoutConfigId: {{ layoutConfigId }}</text>
				</view>
				<text class="hint" v-else>未收到 layoutConfigId 参数</text>
			</view>

			<!-- ============================================================ -->
			<!-- Back -->
			<!-- ============================================================ -->
			<view class="section">
				<button class="btn btn-default" @click="handleBack">
					router.back() — 返回
				</button>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { router } from '@/common/router'

	// ==========================================================================
	// State
	// ==========================================================================
	const layoutConfigId = ref('')

	// ==========================================================================
	// Retrieve the config param passed through the route
	// ==========================================================================
	onMounted(() => {
		const cache = router.getPrevRouterDataCache()
		if (cache != null && cache.params != null) {
			const params = cache.params as UTSJSONObject
			const value = params.getString('layoutConfigId')
			if (value != null) {
				layoutConfigId.value = value
			}
		}
	})

	// ==========================================================================
	// Plain back
	// ==========================================================================
	function handleBack(): void {
		router.back()
	}
</script>

