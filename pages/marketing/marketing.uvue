		padding: 20rpx;
		margin-bottom: 16rpx;
	}

	.info-text {
		font-size: 26rpx;
		color: #555;
		margin-bottom: 8rpx;
	}

	.code {
		font-size: 26rpx;
		color: #555;
	}

	.hint {
		font-size: 24rpx;
		color: #999;
		margin-top: 8rpx;
	}

	.flow {
		margin-top: 10rpx;
	}

	.flow-item {
		font-size: 26rpx;
		color: #666;
		padding: 6rpx 0;
