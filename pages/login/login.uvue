		align-items: center;
		margin-bottom: 16rpx;
	}

	.label {
		width: 140rpx;
		font-size: 28rpx;
		color: #666;
	}

	.input {
		flex: 1;
		border: 1rpx solid #ddd;
		border-radius: 8rpx;
		padding: 12rpx 16rpx;
		font-size: 28rpx;
		background: #fafafa;
	}

	.btn {
		margin-bottom: 16rpx;
