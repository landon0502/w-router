<template>
	<scroll-view class="page" scroll-y="true">
		<view class="container">
			<view class="header">
				<text class="title">登录页 (Login)</text>
				<text class="subtitle">鉴权守卫 (Auth Guard) 示例</text>
			</view>

			<!-- ============================================================ -->
			<!-- Login Form -->
			<!-- ============================================================ -->
			<view class="section">
				<text class="section-title">模拟登录</text>

				<view class="input-group">
					<text class="label">用户名:</text>
					<input class="input" v-model="username" placeholder="请输入用户名" />
				</view>
				<view class="input-group">
					<text class="label">密码:</text>
					<input class="input" v-model="password" type="password" placeholder="请输入密码" />
				</view>

				<button class="btn btn-success" @click="handleLogin">
					登录
				</button>

				<button class="btn btn-default" @click="handleBack">
					返回首页
				</button>
			</view>

			<!-- ============================================================ -->
			<!-- Explanation -->
			<!-- ============================================================ -->
			<view class="section">
				<text class="section-title">中间件工作流程</text>
				<view class="flow">
					<text class="flow-item">1. 用户点击"跳转详情页"</text>
					<text class="flow-item">2. 全局 authGuard 中间件检查登录状态</text>
					<text class="flow-item">3. 未登录 → 弹出提示，跳转到本登录页</text>
					<text class="flow-item">4. 登录页在白名单中，不会被拦截</text>
					<text class="flow-item">5. 用户登录后返回首页，再次跳转成功</text>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { router, setLoggedIn } from '@/common/router'

	// ==========================================================================
	// State
	// ==========================================================================
	const username = ref('')
	const password = ref('')

	// ==========================================================================
	// Login handler
	// ==========================================================================
	function handleLogin(): void {
		if (username.value == '' || password.value == '') {
			uni.showToast({ title: '请输入用户名和密码', icon: 'none' })
			return
		}

		// 模拟登录
		setLoggedIn(true)
		uni.showToast({ title: '登录成功!', icon: 'success' })

		// 短暂延迟后返回上一页
		setTimeout(() => {
			router.back()
		}, 800)
	}

	// ==========================================================================
	// Back without login
	// ==========================================================================
	function handleBack(): void {
		router.back()
	}
</script>

