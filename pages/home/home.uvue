<template>
	<scroll-view class="page" scroll-y="true">
		<view class="container">
			<view class="header">
				<text class="title">Tab 首页 (Home)</text>
				<text class="subtitle">Tab 导航 与 uni.$emit 通信示例</text>
			</view>

			<!-- ============================================================ -->
			<!-- Explanation -->
			<!-- ============================================================ -->
			<view class="section">
				<text class="section-title">Tab 页面特点</text>
				<view class="card">
					<text class="info-text">
						Tab 页面没有 opener event channel（getOpenerEventChannel 不可用）。
					</text>
					<text class="info-text">
						因此，w-router 对 tab 页面使用 uni.$emit / uni.$on 来传递 params 和 data。
					</text>
					<text class="info-text highlight">
						params 事件名: onRouteParams[/pages/home/home]
					</text>
					<text class="info-text highlight">
						data 事件名: onRouteData[/pages/home/home]
					</text>
				</view>
			</view>

			<!-- ============================================================ -->
			<!-- Received Params -->
			<!-- ============================================================ -->
			<view class="section">
				<text class="section-title">接收的路由参数 (params)</text>
				<view class="card" v-if="paramsText != ''">
					<text class="code">{{ paramsText }}</text>
				</view>
				<text class="hint" v-else>
					未收到 params — 请从首页点击 "router.tab()" 携带参数跳转。
				</text>
			</view>

			<!-- ============================================================ -->
			<!-- Received Data -->
			<!-- ============================================================ -->
			<view class="section">
				<text class="section-title">接收的隐式数据 (data)</text>
				<view class="card" v-if="dataText != ''">
					<text class="code">{{ dataText }}</text>
				</view>
				<text class="hint" v-else>
					未收到 data — 请从首页使用 data 传参跳转到 Tab 页。
				</text>
			</view>

			<!-- ============================================================ -->
			<!-- Navigation -->
			<!-- ============================================================ -->
			<view class="section">
				<button class="btn btn-primary" @click="handleGoToIndex">
					router.tab() — 前往示例首页
				</button>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { router } from '@/common/router'
	import { onRouteParamsEventKey, onRouteDataEventKey } from '@/uni_modules/w-router'

	// ==========================================================================
	// State
	// ==========================================================================
	const paramsText = ref('')
	const dataText = ref('')

	// ==========================================================================
	// Listen for route params/data via uni.$emit (tab page pattern)
	// ==========================================================================
	onMounted(() => {
		// Retrieve cached params and data from the pipeline
		const cache = router.getPrevRouterDataCache()
		if (cache != null) {
			if (cache.params != null) {
				paramsText.value = JSON.stringify(cache.params)
			}
			if (cache.data != null) {
				dataText.value = JSON.stringify(cache.data)
			}
		}

		// Listen via uni.$on for tab-page params (event-based)
		const paramsEventName: string = `${onRouteParamsEventKey}[/pages/home/home]`
		uni.$on(paramsEventName, (data: any) => {
			paramsText.value = JSON.stringify(data)
			console.log('[Tab Home] Received params via uni.$on:', data)
		})

		// Listen via uni.$on for tab-page data (event-based)
		const dataEventName: string = `${onRouteDataEventKey}[/pages/home/home]`
		uni.$on(dataEventName, (data: any) => {
			dataText.value = JSON.stringify(data)
			console.log('[Tab Home] Received data via uni.$on:', data)
		})
	})

	// ==========================================================================
	// Navigate to the demo index page
	// ==========================================================================
	function handleGoToIndex(): void {
		router.tab({ url: '/pages/index/index' })
	}
</script>

<style scoped>
